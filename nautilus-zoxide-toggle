#!/usr/bin/env bash
# nautilus-zoxide-toggle — nautilus 的 z 式目录跳转入口
# created: 2026-07 (pi-desktop session fc28cdef)
# goal  : 复刻 yazi "Z→fzf→回车" 的肌肉记忆：rofi 模糊搜索 zoxide 目录，
#         已有 nautilus 窗口则原地跳转(经扩展 DBus)并聚焦，否则直接启动。
#         选择器用 rofi(X11/XWayland) 而非 fuzzel：fuzzel 无 text-input 协议
#         实现(二进制可证)，永远无法中文输入；rofi 走 XIM→fcitx5 中文可用。
# 用法  : nautilus-zoxide-toggle [-h|--help]
# 依赖  : rofi zoxide gdbus；可选 jq+niri(聚焦) notify-send(失败提示)
# 测试  : ZJ_CHOICE=/some/dir 本命令 可跳过 rofi，供脚本化/自动化验证

set -euo pipefail

BUS=dev.lynncx.zoxidejump
OBJ=/dev/lynncx/zoxidejump
ZOXIDE="${ZOXIDE:-$(command -v zoxide || true)}"
if [[ -z "$ZOXIDE" && -x "$HOME/.local/bin/zoxide" ]]; then
  ZOXIDE="$HOME/.local/bin/zoxide"
fi

help() {
  cat <<'EOF'
nautilus-zoxide-toggle — nautilus 的 z 式目录跳转
用法: nautilus-zoxide-toggle
行为: rofi 模糊搜索 zoxide 常用目录(支持中文输入, fcitx5/XIM)
      - 已有 nautilus 窗口: 当前窗口原地跳转并聚焦 (不开新标签)
      - 无窗口: 在目标目录启动 nautilus
测试: ZJ_CHOICE=/some/dir 运行本命令可跳过选择器 (供自动化)
依赖: rofi zoxide gdbus; 可选 jq niri(聚焦) notify-send(提示)
EOF
  exit 0
}

die() { echo "zjump: $*" >&2; exit 1; }
warn() { echo "zjump: $*" >&2; command -v notify-send >/dev/null 2>&1 && notify-send -a zoxide-jump zjump "$*" || true; }

case "${1:-}" in
  -h|--help) help ;;
  '') ;;
  *) die "unknown arg: $1 (see -h)" ;;
esac

[[ -n "$ZOXIDE" && -x "$ZOXIDE" ]] || die "zoxide not found"
command -v rofi >/dev/null 2>&1 || die "rofi not found"

# 已存在的 nautilus 窗口 id (niri), 空则无窗口
nautilus_id() {
  command -v niri >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  niri msg --json windows 2>/dev/null \
    | jq -re '[.[] | select((.app_id // "") == "org.gnome.Nautilus")][0].id' 2>/dev/null \
    || true
}

pick() {
  if [[ -n "${ZJ_CHOICE:-}" ]]; then
    printf '%s' "$ZJ_CHOICE"
    return 0
  fi
  # rofi 是 X11 程序, 走 XWayland+XIM→fcitx5; 会话通常已带 XMODIFIERS, 这里兜底
  export XMODIFIERS=@im=fcitx
  # "目录名⇥完整路径"：名字和路径都能模糊命中; fuzzy+fzf 排序贴近 yazi/fzf 手感
  "$ZOXIDE" query -l | awk -F/ '{ print $NF "\t" $0 }' \
    | rofi -dmenu -p 'z ' -l 20 \
        -theme-str 'window { width: 720px; }' \
        -kb-row-select '' \
        -matching fuzzy -sorting-method fzf
}

jump() {
  local d="${1//\"/\\\"}"
  gdbus call --session --dest "$BUS" --object-path "$OBJ" \
    --method "$BUS.JumpTo" "\"$d\"" >/dev/null 2>&1
}

main() {
  local dir id
  dir=$(pick) || exit 0
  [[ -n "$dir" ]] || exit 0
  dir="${dir##*$'\t'}"

  id=$(nautilus_id)
  if [[ -n "$id" ]]; then
    if jump "$dir"; then
      niri msg action focus-window --id "$id" >/dev/null 2>&1 || true
      exit 0
    fi
    warn "原地跳转失败(扩展未加载?), 改为开新窗口"
  fi
  setsid nohup nautilus "$dir" >/dev/null 2>&1 </dev/null &
}

main "$@"
